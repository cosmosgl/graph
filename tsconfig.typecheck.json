{
  // Whole-repo typecheck (`pnpm run typecheck`). The base config is scoped to what
  // ships — it drives declaration emit, so `src/stories` is excluded there. This
  // one widens the program to everything we author (stories, tests, and the
  // tool configs included) and emits nothing, so CI checks the examples users
  // actually read and the configs the tools load.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false
  },
  "include": [
    "./src/**/*",
    "./test/**/*",
    "./.storybook/**/*",
    "./vite.config.ts",
    "./vitest.config.ts",
    "./integrations/*/vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
